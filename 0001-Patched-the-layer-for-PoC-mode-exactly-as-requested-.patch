From abf089524712d34227aea8a9c5f1555cddaee7cb Mon Sep 17 00:00:00 2001
From: AHL <rollandoe@gmail.com>
Date: Sun, 19 Jul 2026 18:37:11 +0200
Subject: [PATCH] Patched the layer for PoC mode exactly as requested: dev no
 longer relies on OTP, while prod keeps the OTP/PKCS#11 path.

What changed:

- Added backend switch in certificate generation:
  - rpi-device-certs.sh
  - Supports `RPI_DEVICE_CERT_BACKEND=file|pkcs11`
  - Keeps your existing auto-renew by expiry and SAN drift logic
  - `file` backend now generates and uses `/etc/certs/rpi-device-key.pem`
  - Permissions are now safe for both backends (`key=600`, `cert=644`)

- Added backend env in service:
  - rpi-device-certs.service
  - Added `Environment=RPI_DEVICE_CERT_BACKEND=@RPI_DEVICE_CERT_BACKEND@`

- Wired backend by profile in recipe:
  - rpi-device-certs.bb
  - Build-time substitution sets:
    - `dev` -> `file`
    - non-`dev` (including `prod`) -> `pkcs11`

- Switched nginx TLS config by profile:
  - nginx_%.bbappend
  - Added per-profile site files:
    - default_server_dev.site (file key)
    - default_server_prod.site (PKCS#11 key)

Validation:

- Shell syntax check passed for the updated script.
- Editor diagnostics show no errors in touched files.
- OELint could not be executed because `oelint-adv` is not installed in this environment.

What this gives you now:

- PoC/dev builds can run full HTTPS + nginx + cert renewal without burning OTP.
- Prod behavior remains aligned with hardware-backed PKCS#11 key usage.

Next steps:

1. Rebuild dev image:
   - `KAS_MACHINE=raspberrypi5 SECURITY_PROFILE=dev kas build kas-rpi-secure.yml:kas-signing-keys.yml`
2. Deploy and verify on target:
   - `systemctl status rpi-device-certs`
   - `ls -l /etc/certs/rpi-device-cert.pem /etc/certs/rpi-device-key.pem`
   - `systemctl status nginx`
3. Optional prod sanity build (no deploy) to confirm profile split:
   - `KAS_MACHINE=raspberrypi5 SECURITY_PROFILE=prod kas build kas-rpi-secure.yml:kas-signing-keys.yml`
---
 .../nginx/files/default_server_dev.site       | 32 ++++++++++
 .../nginx/files/default_server_prod.site      | 32 ++++++++++
 recipes-httpd/nginx/nginx_%.bbappend          | 10 +++-
 .../files/rpi-device-certs.service            |  1 +
 .../files/rpi-device-certs.sh                 | 58 ++++++++++++++-----
 .../rpi-device-certs/rpi-device-certs.bb      |  3 +
 6 files changed, 120 insertions(+), 16 deletions(-)
 create mode 100644 recipes-httpd/nginx/files/default_server_dev.site
 create mode 100644 recipes-httpd/nginx/files/default_server_prod.site

diff --git a/recipes-httpd/nginx/files/default_server_dev.site b/recipes-httpd/nginx/files/default_server_dev.site
new file mode 100644
index 0000000000..b4fa6a75b1
--- /dev/null
+++ b/recipes-httpd/nginx/files/default_server_dev.site
@@ -0,0 +1,32 @@
+server {
+
+    listen 443 ssl;
+
+    ssl_certificate        /etc/certs/rpi-device-cert.pem;
+    ssl_certificate_key    /etc/certs/rpi-device-key.pem;
+
+    ssl_protocols TLSv1.3;
+
+    client_max_body_size   512m;
+
+    auth_basic "Restricted Content";
+    auth_basic_user_file /etc/nginx/.htpasswd;
+
+    server_name ~^(?<subdomain>([\w-]+\.)*)?(?<domain>[\w-]+\.[\w-]+)\.dev$;
+
+    location /swupdate/ {
+        proxy_pass http://localhost:8080/;
+        proxy_request_buffering off;
+        proxy_http_version 1.1;
+        proxy_read_timeout 300s;
+    }
+}
+
+server {
+    listen 80 default_server;
+    #listen [::]:80 default_server;
+
+    server_name _;
+
+    return 301 https://$host$request_uri;
+}
diff --git a/recipes-httpd/nginx/files/default_server_prod.site b/recipes-httpd/nginx/files/default_server_prod.site
new file mode 100644
index 0000000000..c7e48e42f5
--- /dev/null
+++ b/recipes-httpd/nginx/files/default_server_prod.site
@@ -0,0 +1,32 @@
+server {
+
+    listen 443 ssl;
+
+    ssl_certificate        /etc/certs/rpi-device-cert.pem;
+    ssl_certificate_key    "store:pkcs11:token=RPi%20OTP%20key;id=%01;type=private";
+
+    ssl_protocols TLSv1.3;
+
+    client_max_body_size   512m;
+
+    auth_basic "Restricted Content";
+    auth_basic_user_file /etc/nginx/.htpasswd;
+
+    server_name ~^(?<subdomain>([\w-]+\.)*)?(?<domain>[\w-]+\.[\w-]+)\.dev$;
+
+    location /swupdate/ {
+        proxy_pass http://localhost:8080/;
+        proxy_request_buffering off;
+        proxy_http_version 1.1;
+        proxy_read_timeout 300s;
+    }
+}
+
+server {
+    listen 80 default_server;
+    #listen [::]:80 default_server;
+
+    server_name _;
+
+    return 301 https://$host$request_uri;
+}
diff --git a/recipes-httpd/nginx/nginx_%.bbappend b/recipes-httpd/nginx/nginx_%.bbappend
index 07b9420fb7..4361dce3e6 100644
--- a/recipes-httpd/nginx/nginx_%.bbappend
+++ b/recipes-httpd/nginx/nginx_%.bbappend
@@ -3,7 +3,8 @@ FILESEXTRAPATHS:prepend := "${THISDIR}/files:"
 SRC_URI:append = " \
                file://nginx-override.conf \
                file://nginx.path \
-               file://default_server.site"
+               file://default_server_dev.site \
+               file://default_server_prod.site"
 
 RDEPENDS:${PN} += "rpi-device-certs"
 
@@ -22,7 +23,12 @@ do_install:append() {
     install -d ${D}${systemd_unitdir}/system/nginx.service.d
     install -m 0644 ${UNPACKDIR}/nginx-override.conf ${D}${systemd_unitdir}/system/nginx.service.d/
     install -m 0644 ${UNPACKDIR}/nginx.path ${D}${systemd_unitdir}/system/
-    install -m 0644 ${UNPACKDIR}/default_server.site ${D}${sysconfdir}/nginx/sites-available/default_server
+
+    if [ "${RPI_SECURITY_PROFILE}" = "dev" ]; then
+        install -m 0644 ${UNPACKDIR}/default_server_dev.site ${D}${sysconfdir}/nginx/sites-available/default_server
+    else
+        install -m 0644 ${UNPACKDIR}/default_server_prod.site ${D}${sysconfdir}/nginx/sites-available/default_server
+    fi
 
 }
 
diff --git a/recipes-support/rpi-device-certs/files/rpi-device-certs.service b/recipes-support/rpi-device-certs/files/rpi-device-certs.service
index 63e10bd43b..6eb95d763f 100644
--- a/recipes-support/rpi-device-certs/files/rpi-device-certs.service
+++ b/recipes-support/rpi-device-certs/files/rpi-device-certs.service
@@ -10,6 +10,7 @@ RemainAfterExit=yes
 WorkingDirectory=/etc/certs
 Environment=RPI_DEVICE_CERT_VALID_DAYS=365
 Environment=RPI_DEVICE_CERT_RENEW_DAYS=30
+Environment=RPI_DEVICE_CERT_BACKEND=@RPI_DEVICE_CERT_BACKEND@
 ExecStart=/usr/bin/rpi-device-certs
 Restart=on-failure
 RestartSec=3
diff --git a/recipes-support/rpi-device-certs/files/rpi-device-certs.sh b/recipes-support/rpi-device-certs/files/rpi-device-certs.sh
index 5b593e7a56..4d8d260aaa 100644
--- a/recipes-support/rpi-device-certs/files/rpi-device-certs.sh
+++ b/recipes-support/rpi-device-certs/files/rpi-device-certs.sh
@@ -7,8 +7,10 @@
 #   --force: regenerate all device certificates even if they already exist
 
 CERT_FILE="rpi-device-cert.pem"
+CERT_KEY_FILE="rpi-device-key.pem"
 CERT_VALID_DAYS="${RPI_DEVICE_CERT_VALID_DAYS:-365}"
 CERT_RENEW_DAYS="${RPI_DEVICE_CERT_RENEW_DAYS:-30}"
+CERT_BACKEND="${RPI_DEVICE_CERT_BACKEND:-pkcs11}"
 
 
 if [ "$1" = "--force" ]; then
@@ -30,6 +32,15 @@ case "$CERT_VALID_DAYS" in
         ;;
 esac
 
+case "$CERT_BACKEND" in
+    pkcs11|file)
+        ;;
+    *)
+        echo "Invalid RPI_DEVICE_CERT_BACKEND: $CERT_BACKEND (expected: pkcs11|file)"
+        exit 1
+        ;;
+esac
+
 RENEW_SECONDS=$((CERT_RENEW_DAYS * 86400))
 
 if [ -f "$CERT_FILE" ] && ! openssl x509 -in "$CERT_FILE" -checkend "$RENEW_SECONDS" -noout >/dev/null 2>&1; then
@@ -70,29 +81,48 @@ SERVER_KEY_ID="${SERVER_KEY_ID:-%01}"
 SERVER_KEY_URI="pkcs11:object=${PKCS11_TOKEN};id=${SERVER_KEY_ID};type=private"
 
 if [ ! -f "$CERT_FILE" ]; then
+    if [ "$CERT_BACKEND" = "pkcs11" ]; then
     # pkcs11-provider reconstructs EC keys with explicit curve parameters:
     # browsers reject these so reencode as named curve (prime256v1)
     openssl pkey -provider pkcs11 -provider default -pubin \
-            -in "pkcs11:object=${PKCS11_TOKEN};id=${SERVER_KEY_ID};type=public" \
-            -pubout | \
+        -in "pkcs11:object=${PKCS11_TOKEN};id=${SERVER_KEY_ID};type=public" \
+        -pubout | \
     openssl ec -pubin -param_enc named_curve -out rpi-device-pubkey.pem || exit 1
 
     openssl req -new -provider pkcs11 -provider default \
-            -key "$SERVER_KEY_URI" \
-            -subj "/C=DE/ST=BW/O=Embetrix/OU=DeviceCert/CN=$HOSTNAME" \
-            -addext "subjectAltName=DNS:$HOSTNAME,DNS:localhost,IP:$DEVICE_IP,IP:127.0.0.1" \
-            -addext "keyUsage=digitalSignature" \
-            -addext "extendedKeyUsage=serverAuth" \
-            -out rpi-device-cert.csr || exit 1
+        -key "$SERVER_KEY_URI" \
+        -subj "/C=DE/ST=BW/O=Embetrix/OU=DeviceCert/CN=$HOSTNAME" \
+        -addext "subjectAltName=DNS:$HOSTNAME,DNS:localhost,IP:$DEVICE_IP,IP:127.0.0.1" \
+        -addext "keyUsage=digitalSignature" \
+        -addext "extendedKeyUsage=serverAuth" \
+        -out rpi-device-cert.csr || exit 1
 
     openssl x509 -req -in rpi-device-cert.csr \
-            -force_pubkey rpi-device-pubkey.pem \
-            -signkey "$SERVER_KEY_URI" \
-            -provider pkcs11 -provider default \
-            -out "$CERT_FILE" -days "$CERT_VALID_DAYS" \
-            -copy_extensions copyall || exit 1
+        -force_pubkey rpi-device-pubkey.pem \
+        -signkey "$SERVER_KEY_URI" \
+        -provider pkcs11 -provider default \
+        -out "$CERT_FILE" -days "$CERT_VALID_DAYS" \
+        -copy_extensions copyall || exit 1
 
     rm -f rpi-device-pubkey.pem rpi-device-cert.csr
+    else
+    if [ ! -f "$CERT_KEY_FILE" ]; then
+        openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:prime256v1 \
+        -out "$CERT_KEY_FILE" || exit 1
+    fi
+
+    openssl req -new -x509 -sha256 \
+        -key "$CERT_KEY_FILE" \
+        -subj "/C=DE/ST=BW/O=Embetrix/OU=DeviceCert/CN=$HOSTNAME" \
+        -addext "subjectAltName=DNS:$HOSTNAME,DNS:localhost,IP:$DEVICE_IP,IP:127.0.0.1" \
+        -addext "keyUsage=digitalSignature" \
+        -addext "extendedKeyUsage=serverAuth" \
+        -out "$CERT_FILE" -days "$CERT_VALID_DAYS" || exit 1
+    fi
 fi
 
-chmod 644 *.pem
+chmod 644 "$CERT_FILE"
+
+if [ -f "$CERT_KEY_FILE" ]; then
+    chmod 600 "$CERT_KEY_FILE"
+fi
diff --git a/recipes-support/rpi-device-certs/rpi-device-certs.bb b/recipes-support/rpi-device-certs/rpi-device-certs.bb
index 20e452d13c..e4ee0e9efc 100644
--- a/recipes-support/rpi-device-certs/rpi-device-certs.bb
+++ b/recipes-support/rpi-device-certs/rpi-device-certs.bb
@@ -27,6 +27,9 @@ do_install:append() {
 	install -d ${D}${systemd_unitdir}/system
 	install -m 0644 ${UNPACKDIR}/rpi-device-certs.service ${D}${systemd_unitdir}/system/
     install -m 0644 ${UNPACKDIR}/rpi-device-certs.timer ${D}${systemd_unitdir}/system/
+
+    backend="${@bb.utils.contains('RPI_SECURITY_PROFILE', 'dev', 'file', 'pkcs11', d)}"
+    sed -i "s/@RPI_DEVICE_CERT_BACKEND@/${backend}/" ${D}${systemd_unitdir}/system/rpi-device-certs.service
 }
 
 FILES:${PN} = "${bindir} \
