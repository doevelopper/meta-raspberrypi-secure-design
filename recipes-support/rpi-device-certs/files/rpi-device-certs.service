[Unit]
Description=device certificates creation service
After=network-online.target
Wants=network-online.target
Before=nginx.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/certs
Environment=RPI_DEVICE_CERT_VALID_DAYS=365
Environment=RPI_DEVICE_CERT_RENEW_DAYS=30
Environment=RPI_DEVICE_CERT_BACKEND=@RPI_DEVICE_CERT_BACKEND@
ExecStart=/usr/bin/rpi-device-certs
Restart=on-failure
RestartSec=3

[Install]   
WantedBy=multi-user.target
